CONFIG_IDF_TARGET="esp32c6"

# Primary Console on USB Serial / JTAG (Native USB-C port @ 115200 baud)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# FreeRTOS 1000Hz tick rate
CONFIG_FREERTOS_HZ=1000

# Compiler Optimization for Size (-Os)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Flash Configuration for ESP32-C6FH4 (4MB Flash)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Bluetooth Low Energy Configuration (NimBLE Stack)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Silence NimBLE notification INFO spam
CONFIG_BT_NIMBLE_LOG_LEVEL_INFO=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# Wi-Fi Configuration for ESP-NOW Mesh
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# Software Wireless Coexistence (Simultaneous BLE and Wi-Fi / ESP-NOW)
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y